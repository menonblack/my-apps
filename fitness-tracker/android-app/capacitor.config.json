{
  "appId": "io.github.menonblack.liftlog",
  "appName": "Lift Log",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "LiveUpdate": {
      "readyTimeout": 15000,
      "autoDeleteBundles": true,
      "autoBlockRolledBackBundles": true
    }
  }
}
